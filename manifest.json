{
  "manifest_version": 3,
  "name": "ProfiECU Autofill",
  "version": "2.5",
  "description": "Automatické vyplnění DPD a iDoklad formulářů z ProfiECU",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://shipping.dpdgroup.com/*",
    "https://app.idoklad.cz/*",
    "https://profiecu.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://shipping.dpdgroup.com/*"],
      "js": ["content-dpd.js"]
    },
    {
      "matches": ["https://app.idoklad.cz/IssuedInvoice/Create*"],
      "js": ["bridge-idoklad.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.idoklad.cz/IssuedInvoice/Create*"],
      "js": ["content-idoklad.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
